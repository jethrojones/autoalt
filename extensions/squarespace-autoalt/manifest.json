{
  "manifest_version": 3,
  "name": "AutoAlt for Squarespace",
  "version": "0.1.0",
  "description": "Premium AI-powered alternative descriptions for Squarespace Image Blocks and Asset Libraries automatically using Gemini or OpenAI.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://*.squarespace.com/*",
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://*.squarespace.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html"
}
